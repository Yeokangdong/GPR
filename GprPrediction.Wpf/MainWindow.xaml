<Window x:Class="GprPrediction.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:GprPrediction.Wpf.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="GPR"
        Height="800"
        Width="1280"
        MinHeight="600"
        MinWidth="860"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                        Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                        Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}"
                        Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}"
                        Executed="CloseWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValueBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="ResultSelectorButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="62" />
            <Setter Property="MinWidth" Value="72" />
        </Style>

        <Style x:Key="ViewResetButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BorderBrush1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A12018" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="10,0,10,0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="10,0,10,0" />
                <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="Maximized">
                        <Setter Property="Margin" Value="10,8,10,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBackgroundBrush}"
                Margin="-10,0,-10,0"
                Padding="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="Maximized">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="-10,4,-10,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,3,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="pack://application:,,,/Assets/GprRadar.png"
                           Width="24"
                           Height="24"
                           Margin="0,-1,10,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="GPR"
                               FontSize="17"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,-1,0,0"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1"
                               Height="18"
                               Fill="{StaticResource BorderBrush1}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Command"
                                Command="{Binding OpenCommandCommand}"
                                Style="{StaticResource NavButton}"
                                ToolTip="질문형 분석 명령 창"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="Map"
                                Command="{Binding OpenMapCommand}"
                                Style="{StaticResource NavButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="Print"
                                Command="{Binding OpenPrintCommand}"
                                Style="{StaticResource NavButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="Manual"
                                Command="{Binding OpenManualCommand}"
                                Style="{StaticResource NavButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="결과 폴더"
                                Command="{Binding OpenResultFolderCommand}"
                                Style="{StaticResource NavButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="초기화"
                                Command="{Binding ResetAnalysisCommand}"
                                Style="{StaticResource NavButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <TextBlock Text="{Binding TodayText}"
                               Margin="0,0,18,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DigitalClockText}"
                               FontFamily="Consolas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" />
                    <Button Style="{StaticResource TitleBarButton}"
                            Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{x:Static SystemCommands.CloseWindowCommand}"
                            Style="{StaticResource TitleBarCloseButton}"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid ClipToBounds="True">
                        <Grid Margin="12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Width="3"
                                        Height="14"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="GPR DATA LABELING" Style="{StaticResource PanelLabel}" />
                            </StackPanel>
                            <Image Source="{Binding AnalysisImage}"
                                   Stretch="Uniform"
                                   Margin="0,24,0,0" />
                            <TextBlock Margin="0,26,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Text="{Binding ScanFileDisplayName}"
                                       ToolTip="{Binding ScanFilePath}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasAnalysisImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid ClipToBounds="True">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="3"
                                        Height="14"
                                        CornerRadius="2"
                                        Background="#7C4DFF"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="ANALYSIS RESULTS" Style="{StaticResource PanelLabel}" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Height="44"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Content="Analysis"
                                    Command="{Binding OpenInputCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#5A98FF" Offset="0" />
                                                    <GradientStop Color="#7C4DFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#5A98FF" Offset="0" />
                                                    <GradientStop Color="#7C4DFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X (측정방향 거리)"
                                                   FontSize="15"
                                                   FontWeight="Black"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AnalysisDistance, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MetricValueBox}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="(m)"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Z (심도)"
                                                   FontSize="15"
                                                   FontWeight="Black"
                                                   FontFamily="Consolas"
                                                   Foreground="#00D4AA" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AnalysisDepth, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MetricValueBox}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="(m)"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="4">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="C (신뢰도)"
                                                   FontSize="15"
                                                   FontWeight="Black"
                                                   FontFamily="Consolas"
                                                   Foreground="#FFB300" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AnalysisConfidence, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MetricValueBox}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="(%)"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                    <Grid ClipToBounds="True">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="3"
                                        Height="14"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="매설물 선택 #1 ~ 16" Style="{StaticResource PanelLabel}" />
                            </StackPanel>

                            <UniformGrid Grid.Row="2"
                                         Columns="4"
                                         Rows="4"
                                         VerticalAlignment="Top">
                                <Button Content="1"  Command="{Binding SelectResultCommand}" CommandParameter="1"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="2"  Command="{Binding SelectResultCommand}" CommandParameter="2"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="3"  Command="{Binding SelectResultCommand}" CommandParameter="3"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="4"  Command="{Binding SelectResultCommand}" CommandParameter="4"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="5"  Command="{Binding SelectResultCommand}" CommandParameter="5"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="6"  Command="{Binding SelectResultCommand}" CommandParameter="6"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="7"  Command="{Binding SelectResultCommand}" CommandParameter="7"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="8"  Command="{Binding SelectResultCommand}" CommandParameter="8"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="9"  Command="{Binding SelectResultCommand}" CommandParameter="9"  Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="10" Command="{Binding SelectResultCommand}" CommandParameter="10" Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="11" Command="{Binding SelectResultCommand}" CommandParameter="11" Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="12" Command="{Binding SelectResultCommand}" CommandParameter="12" Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="13" Command="{Binding SelectResultCommand}" CommandParameter="13" Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="14" Command="{Binding SelectResultCommand}" CommandParameter="14" Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="15" Command="{Binding SelectResultCommand}" CommandParameter="15" Style="{StaticResource ResultSelectorButton}" />
                                <Button Content="16" Command="{Binding SelectResultCommand}" CommandParameter="16" Style="{StaticResource ResultSelectorButton}" />
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid ClipToBounds="True">
                        <Grid VerticalAlignment="Top" Margin="12,12,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14" CornerRadius="2"
                                        Background="#00D4AA" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="TOP VIEW" Style="{StaticResource PanelLabel}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="초기화"
                                    Style="{StaticResource ViewResetButton}"
                                    Click="ResetTopView_Click" />
                        </Grid>
                        <Grid x:Name="TopViewSurface"
                              Margin="0,30,0,0"
                              Background="Transparent"
                              ClipToBounds="True"
                              Cursor="SizeAll"
                              MouseLeftButtonDown="ViewSurface_MouseLeftButtonDown"
                              MouseLeftButtonUp="ViewSurface_MouseLeftButtonUp"
                              MouseMove="ViewSurface_MouseMove"
                              MouseLeave="ViewSurface_MouseLeave"
                              MouseWheel="ViewSurface_MouseWheel">
                            <Canvas x:Name="TopViewCanvas"
                                    Background="Transparent"
                                    SizeChanged="ViewCanvas_SizeChanged" />
                        </Grid>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                Padding="10,8"
                                Background="#C4181D24"
                                BorderBrush="{StaticResource BorderBrush1}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False">
                            <StackPanel x:Name="TopViewRankOverlay" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid ClipToBounds="True">
                        <Grid VerticalAlignment="Top" Margin="12,12,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14" CornerRadius="2"
                                        Background="#7C4DFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="FRONT VIEW" Style="{StaticResource PanelLabel}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="초기화"
                                    Style="{StaticResource ViewResetButton}"
                                    Click="ResetFrontView_Click" />
                        </Grid>
                        <Grid x:Name="FrontViewSurface"
                              Margin="0,30,0,0"
                              Background="Transparent"
                              ClipToBounds="True"
                              Cursor="SizeAll"
                              MouseLeftButtonDown="ViewSurface_MouseLeftButtonDown"
                              MouseLeftButtonUp="ViewSurface_MouseLeftButtonUp"
                              MouseMove="ViewSurface_MouseMove"
                              MouseLeave="ViewSurface_MouseLeave"
                              MouseWheel="ViewSurface_MouseWheel">
                            <Canvas x:Name="FrontViewCanvas"
                                    Background="Transparent"
                                    SizeChanged="ViewCanvas_SizeChanged" />
                        </Grid>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                Padding="10,8"
                                Background="#C4181D24"
                                BorderBrush="{StaticResource BorderBrush1}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False">
                            <StackPanel x:Name="FrontViewRankOverlay" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource StatusBarBackgroundBrush}"
                Padding="12,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="-10,0,-10,0" />
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="#5BC06A"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="10"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CoordinateReferenceText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="9.5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="12,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding BuildInfoText}"
                           Foreground="#E4ECF9"
                           FontSize="9.5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Background="{StaticResource BackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="Maximized">
                            <Setter Property="Height" Value="8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>

