<Window x:Class="GprPrediction.Wpf.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GprPrediction.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GPR 준비 중"
        Width="600"
        SizeToContent="Height"
        MinHeight="480"
        MaxHeight="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource DashboardBackground}"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DashboardBlue}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource DashboardInset}"
                                BorderBrush="{DynamicResource DashboardInsetBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           Visibility="Collapsed" />
                                <Grid x:Name="IndeterminateRoot" ClipToBounds="True">
                                    <Rectangle Width="170"
                                               HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#004C8DFF" Offset="0" />
                                                <GradientStop Color="#FF70A8FF" Offset="0.5" />
                                                <GradientStop Color="#004C8DFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="ProgressSlide" X="-170" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ProgressSlide"
                                                         Storyboard.TargetProperty="X"
                                                         From="-170"
                                                         To="620"
                                                         Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsIndeterminate" Value="False">
                                <Setter TargetName="PART_Indicator"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="IndeterminateRoot"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuntimeCard" TargetType="Border">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource DashboardPanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashboardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Direction="270"
                                      ShadowDepth="2"
                                      BlurRadius="10"
                                      Opacity="0.22" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static local:ComponentState.Checking}">
                    <Setter Property="Background" Value="{DynamicResource DashboardSelected}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DashboardBlue}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static local:ComponentState.Fail}">
                    <Setter Property="BorderBrush" Value="#A84D63" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateIconBorder" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource DashboardInset}" />
            <Setter Property="BorderBrush" Value="{Binding IconBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static local:ComponentState.Checking}">
                    <Setter Property="Background" Value="{DynamicResource DashboardSelected}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#4C8DFF"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.25" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VersionBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashboardInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashboardInsetBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="8,0,14,0" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DashboardBackground}"
            BorderBrush="{DynamicResource DashboardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,22,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Border Width="60"
                            Height="60"
                            CornerRadius="15"
                            BorderBrush="{DynamicResource DashboardBorderHover}"
                            BorderThickness="1"
                            Background="{DynamicResource DashboardPanel}"
                            HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/Assets/GprRadar.png"
                               Width="44"
                               Height="44"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM INITIALIZATION"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashboardBlue}" />
                        <TextBlock Text="GPR"
                                   Margin="0,2,0,1"
                                   FontSize="27"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="지하매설물 제원 예측 소프트웨어"
                                   FontSize="11"
                                   Foreground="{DynamicResource DashboardMuted}" />
                    </StackPanel>

                    <Canvas Grid.Column="2"
                            Width="150"
                            Height="86"
                            HorizontalAlignment="Right"
                            Opacity="0.55"
                            IsHitTestVisible="False">
                        <Ellipse Canvas.Left="72"
                                 Canvas.Top="4"
                                 Width="110"
                                 Height="110"
                                 Stroke="{DynamicResource DashboardBorder}"
                                 StrokeThickness="1" />
                        <Ellipse Canvas.Left="94"
                                 Canvas.Top="26"
                                 Width="66"
                                 Height="66"
                                 Stroke="{DynamicResource DashboardBlue}"
                                 StrokeThickness="1" />
                        <Ellipse Canvas.Left="116"
                                 Canvas.Top="48"
                                 Width="22"
                                 Height="22"
                                 Fill="{DynamicResource DashboardSelected}" />
                    </Canvas>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource DashboardBorder}" />

                <ItemsControl Grid.Row="4" ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RuntimeCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{Binding IconBrush}" />

                                    <Border Grid.Column="1"
                                            Style="{StaticResource StateIconBorder}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}"
                                                   Foreground="{Binding IconBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   FontFamily="Segoe UI Symbol, Malgun Gothic"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Height="3"
                                                Width="72"
                                                Margin="0,7,0,0"
                                                Background="{DynamicResource DashboardInsetBorder}"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}"
                                                                     Value="{x:Static local:ComponentState.Checking}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                            Style="{StaticResource VersionBadge}"
                                            Visibility="{Binding VersionVisible}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VersionText}"
                                                   FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="{Binding IconBrush}" />
                                    </Border>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding StatusText}"
                                               Margin="0,0,16,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding IconBrush}"
                                               TextWrapping="NoWrap"
                                               TextAlignment="Right"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="6"
                        Visibility="{Binding ProgressRowVisibility}"
                        Background="{DynamicResource DashboardPanel}"
                        BorderBrush="{DynamicResource DashboardBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,11">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          Direction="270"
                                          ShadowDepth="3"
                                          BlurRadius="14"
                                          Opacity="0.2" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="{DynamicResource DashboardSelected}"
                                    BorderBrush="{DynamicResource DashboardBlue}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="{DynamicResource DashboardBlue}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="실행 환경 구성 중"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="필수 알고리즘 환경을 준비하고 있습니다"
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource DashboardMuted}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DownloadPercentText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DashboardBlue}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Margin="0,10,0,0"
                                     Style="{StaticResource ModernProgress}"
                                     Value="{Binding DownloadProgress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminateProgress, Mode=OneWay}" />

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding DownloadLabel}"
                                       Margin="0"
                                       FontSize="10"
                                       Foreground="{DynamicResource DashboardMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DownloadDetailsVisibility}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="8"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="10"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding ErrorButtonsVisibility}">
                    <Button Content="Julia 없이 계속"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding SkipJuliaVisibility}"
                            Click="SkipJulia_Click"
                            Margin="0,0,8,0" />
                    <Button Content="다시 시도"
                            Style="{StaticResource PrimaryButton}"
                            Click="Retry_Click"
                            Margin="0,0,8,0" />
                    <Button Content="닫기"
                            Style="{StaticResource SecondaryButton}"
                            Click="CloseApp_Click" />
                </StackPanel>

                <StackPanel Grid.Row="10"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorButtonsVisibility}"
                                             Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE724;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="{DynamicResource DashboardBlue}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="설치가 완료되면 자동으로 시작됩니다"
                               Margin="8,0,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource DashboardMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
