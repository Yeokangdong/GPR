<Window x:Class="GprPrediction.Wpf.Windows.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPR 병합"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="980"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MergeGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#20293A" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="MergeGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Background" Value="#A9A9A9" />
                <Setter Property="BorderBrush" Value="#8C8C8C" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Foreground" Value="#111111" />
            </Style>

            <Style x:Key="MergeGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="#A9A9A9" />
                <Setter Property="Foreground" Value="#111111" />
                <Setter Property="MinHeight" Value="30" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBarBackgroundBrush}"
                BorderThickness="0">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="pack://application:,,,/Assets/GprRadar.png"
                           Width="24"
                           Height="24"
                           Margin="0,-1,10,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="GPR"
                               FontSize="17"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,-1,0,0"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1"
                               Height="18"
                               Fill="{StaticResource BorderBrush1}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" />
                    <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                            Style="{StaticResource TitleBarButton}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{x:Static SystemCommands.CloseWindowCommand}"
                            Style="{StaticResource TitleBarCloseButton}"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4"
                                    Height="16"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="GPR 병합"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Margin="14,10,0,0"
                                   Text="결과 파일별 점을 행 단위로 묶어서 원본 프로그램처럼 병합 방향을 선택합니다."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="샘플 폴더 열기"
                                Width="110"
                                Height="34"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenFolder_Click" />
                        <Button Content="파일 추가"
                                Width="96"
                                Height="34"
                                Style="{StaticResource PrimaryButton}"
                                Click="Browse_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush1}"
                            BorderThickness="0,0,0,1"
                            Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="3"
                                        Height="14"
                                        Background="#7C4DFF"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="결과 방향 선택"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="SelectionSummaryText"
                                       Grid.Column="1"
                                       Text="0개 행 선택"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="16">
                        <DataGrid x:Name="MergeGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  CurrentCellChanged="MergeGrid_CurrentCellChanged"
                                  CellEditEnding="MergeGrid_CellEditEnding"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single"
                                  SelectionUnit="CellOrRowHeader"
                                  Background="#B0B0B0"
                                  BorderBrush="{StaticResource BorderBrush1}"
                                  Foreground="#111111"
                                  ColumnHeaderStyle="{StaticResource MergeGridHeaderStyle}"
                                  CellStyle="{StaticResource MergeGridCellStyle}"
                                  RowStyle="{StaticResource MergeGridRowStyle}"
                                  RowHeight="30"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <Border x:Name="LoadingOverlay"
                                Background="#90020308"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="병합 결과를 준비하는 중..."
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />
                                <ProgressBar Width="180"
                                             Height="8"
                                             IsIndeterminate="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="확인"
                        Width="100"
                        Height="34"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Apply_Click" />
                <Button Content="취소"
                        Width="100"
                        Height="34"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

