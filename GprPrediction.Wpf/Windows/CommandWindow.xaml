<Window x:Class="GprPrediction.Wpf.Windows.CommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPR Command"
        Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ScrollPageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
                <Setter Property="Background" Value="#526B84" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbBody"
                                    Margin="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#7792AC"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="#6687A8" />
                                    <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#91B8DC" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="#3989E5" />
                                    <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#8CC5FF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ControlTemplate x:Key="VerticalScrollBarTemplate"
                             TargetType="{x:Type ScrollBar}">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="#263545"
                        BorderThickness="1,0,0,0">
                    <Grid Margin="1">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="44"
                                       Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                             TargetType="{x:Type ScrollBar}">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="#263545"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="1">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="False"
                               Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                              Style="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinWidth="44"
                                       Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                              Style="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="#0A1017" />
                <Setter Property="Foreground" Value="#526B84" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template"
                        Value="{StaticResource VerticalScrollBarTemplate}" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Template"
                                Value="{StaticResource HorizontalScrollBarTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LogFollowToggle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Foreground" Value="#9AAABD" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Root"
                                    Padding="{TemplateBinding Padding}"
                                    Background="#141B23"
                                    BorderBrush="#334150"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border x:Name="Track"
                                            Width="30" Height="16"
                                            Margin="0,0,8,0"
                                            Background="#354250"
                                            CornerRadius="8">
                                        <Ellipse x:Name="Knob"
                                                 Width="10" Height="10"
                                                 Margin="3"
                                                 HorizontalAlignment="Left"
                                                 Fill="#AAB6C4" />
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1A242F" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#50647A" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#DDEBFF" />
                                    <Setter TargetName="Root" Property="Background" Value="#12263D" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#3B82D0" />
                                    <Setter TargetName="Track" Property="Background" Value="#3989E5" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Fill" Value="White" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#79B7FF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LogToolbarButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="Background" Value="#1B2530" />
                <Setter Property="Foreground" Value="#C8D5E3" />
                <Setter Property="BorderBrush" Value="#3A4959" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Root"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#243445" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#5680AC" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#10243A" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#3989E5" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#79B7FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBarBackgroundBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="pack://application:,,,/Assets/GprRadar.png"
                           Width="24" Height="24"
                           Margin="0,-1,10,0" />
                    <TextBlock Text="GPR"
                               FontSize="17"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="18"
                               Fill="{StaticResource BorderBrush1}"
                               Margin="12,0"
                               Opacity="0.5" />
                    <TextBlock Text="Command"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE923;"
                            ToolTip="복원"
                            Click="MaximizeRestore_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Command="{x:Static SystemCommands.CloseWindowCommand}"
                            Style="{StaticResource TitleBarCloseButton}"
                            Content="&#xE8BB;"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LogStatusText"
                           Text="출력 준비"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" />
                <ToggleButton x:Name="AutoScrollCheckBox"
                              Grid.Column="1"
                              Content="자동 따라가기"
                              IsChecked="True"
                              Margin="12,0,8,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource LogFollowToggle}"
                              Checked="AutoScrollCheckBox_Changed"
                              Unchecked="AutoScrollCheckBox_Changed"
                              ToolTip="새 로그가 출력되면 자동으로 따라갑니다." />
                <Button Grid.Column="2"
                        Style="{StaticResource LogToolbarButton}"
                        Click="ScrollToLatest_Click"
                        ToolTip="가장 최근 로그로 이동">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74B;"
                                   Margin="0,0,7,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="최신 로그"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <RichTextBox x:Name="OutputTextBox" Grid.Row="1"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Visible"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="#0D1117" Foreground="#DDE7F2"
                         BorderBrush="#39424E" Padding="12"
                         Cursor="IBeam"
                         IsReadOnlyCaretVisible="True"
                         ScrollViewer.ScrollChanged="OutputTextBox_ScrollChanged">
                <FlowDocument PagePadding="0">
                    <Paragraph x:Name="OutputParagraph"
                               Margin="0"
                               Foreground="#DDE7F2" />
                </FlowDocument>
            </RichTextBox>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputTextBox"
                         FontFamily="Consolas" FontSize="14"
                         Background="#252A31" Foreground="White"
                         BorderBrush="#526071" Padding="10,7"
                         KeyDown="InputTextBox_KeyDown" />
                <Button Grid.Column="1" Content="입력"
                        Margin="8,0,0,0" Click="Submit_Click"
                        Background="#4F8DF7" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" />
            </Grid>
        </Grid>
    </Grid>
</Window>
