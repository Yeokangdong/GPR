<Window x:Class="GprPrediction.Wpf.Windows.ResultOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="측정결과 열기"
        Height="620"
        Width="900"
        MinHeight="520"
        MinWidth="760"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ResultItemCard" TargetType="Border">
                <Setter Property="Background" Value="#101B29" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#17375C" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="1.4" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MetaBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush1}"
                BorderThickness="0,0,0,1">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="pack://application:,,,/Assets/GprRadar.png"
                           Width="22"
                           Height="22"
                           Margin="0,-1,10,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="GPR"
                               FontSize="16"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,-1,0,0"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1"
                               Height="18"
                               Fill="{StaticResource BorderBrush1}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}" Style="{StaticResource TitleBarButton}" Content="&#xE921;" />
                    <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}" Style="{StaticResource TitleBarButton}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{x:Static SystemCommands.CloseWindowCommand}" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="측정결과 열기" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Margin="14,10,0,0"
                                   Text="불러온 SEN 결과를 고르면 지도 화면에서 바로 비교하고 병합할 수 있습니다."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="전체 선택"
                                Width="92"
                                Height="34"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="SelectAll_Click" />
                        <Button Content="선택 해제"
                                Width="92"
                                Height="34"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="ClearSelection_Click" />
                        <Button Content="폴더 열기"
                                Width="100"
                                Height="34"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14" Background="#00D4AA" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="저장 결과 목록" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ResultList"
                             Grid.Row="1"
                             Margin="16"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ResultItemCard}"
                                        MouseLeftButtonUp="ResultItemCard_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="18"
                                                  Height="18"
                                                  Margin="6,8,10,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top"
                                                  Checked="SelectionChanged_Update"
                                                  Unchecked="SelectionChanged_Update" />

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Style="{StaticResource MetaBadge}">
                                                <TextBlock Text="{Binding FileSizeText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource MetaBadge}">
                                                <TextBlock Text="{Binding ModifiedText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#90020308" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="결과 목록을 불러오는 중..."
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <ProgressBar Width="180" Height="8" IsIndeterminate="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="열기"
                        Width="100"
                        Height="34"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Apply_Click" />
                <Button Content="취소"
                        Width="100"
                        Height="34"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
