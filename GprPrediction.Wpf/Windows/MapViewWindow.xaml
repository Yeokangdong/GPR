<Window x:Class="GprPrediction.Wpf.Windows.MapViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="RootWindow"
        Title="Map View"
        Height="820"
        Width="1360"
        MinHeight="680"
        MinWidth="1080"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="MaximizeRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="MapChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MinWidth" Value="72" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PanelHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="34" />
                <Setter Property="FontSize" Value="12" />
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="0,8,0,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush1}"
                BorderThickness="0,0,0,1">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="pack://application:,,,/Assets/GprRadar.png"
                           Width="22"
                           Height="22"
                           Margin="0,-1,10,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="GPR"
                               FontSize="16"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,-1,0,0"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1"
                               Height="18"
                               Fill="{StaticResource BorderBrush1}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" />
                    <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                            Style="{StaticResource TitleBarButton}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{x:Static SystemCommands.CloseWindowCommand}"
                            Style="{StaticResource TitleBarCloseButton}"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4"
                                    Height="16"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Map View"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Margin="14,6,0,0"
                                   Text="측정 결과선과 배경 지도를 같은 좌표계에서 확인합니다."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="결과 파일 열기"
                                Style="{StaticResource CompactActionButton}"
                                Margin="0,0,8,0"
                                Click="OpenSavedResults_Click" />
                        <Button Content="GPR 병합"
                                Style="{StaticResource CompactActionButton}"
                                Click="OpenMergeWindow_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource BorderBrush1}"
                                BorderThickness="0,0,0,1"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3"
                                            Height="14"
                                            Background="#00D4AA"
                                            CornerRadius="2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="측선 위치" Style="{StaticResource PanelHeaderText}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="초기화"
                                        Style="{StaticResource CompactActionButton}"
                                        Padding="12,0"
                                        Click="ResetMapView_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                x:Name="MapSurface"
                                Background="#181818"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="MapSurface_MouseLeftButtonDown"
                                MouseLeftButtonUp="MapSurface_MouseLeftButtonUp"
                                MouseMove="MapSurface_MouseMove"
                                MouseLeave="MapSurface_MouseLeave"
                                MouseWheel="MapSurface_MouseWheel">
                            <Grid ClipToBounds="True">
                                <Image x:Name="BackgroundImageLayer"
                                       Source="{Binding MapBackgroundImage}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       SnapsToDevicePixels="True"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="LowQuality" />

                                <Grid x:Name="MapCanvas"
                                      Width="800"
                                      Height="580"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Background="Transparent"
                                      RenderOptions.EdgeMode="Aliased"
                                      SnapsToDevicePixels="True">

                                    <Line X1="{Binding SurveyLineX1}"
                                          Y1="{Binding SurveyLineY1}"
                                          X2="{Binding SurveyLineX2}"
                                          Y2="{Binding SurveyLineY2}"
                                          Stroke="{StaticResource DangerBrush}"
                                          StrokeThickness="{Binding SurveyLineStrokeThickness, RelativeSource={RelativeSource AncestorType=Window}}" />

                                    <ItemsControl ItemsSource="{Binding SavedResultLineSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}"
                                                      Y1="{Binding Y1}"
                                                      X2="{Binding X2}"
                                                      Y2="{Binding Y2}"
                                                      Stroke="#7C4DFF"
                                                      StrokeThickness="{Binding MergeLineStrokeThickness, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      SnapsToDevicePixels="True"
                                                      Opacity="0.95" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Canvas Width="120"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ScaleY="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TranslateTransform X="{Binding SurveyLineX1}"
                                                                    Y="{Binding SurveyLineY1}" />
                                            </TransformGroup>
                                        </Canvas.RenderTransform>
                                        <Ellipse Canvas.Left="-6"
                                                 Canvas.Top="-6"
                                                 Width="12"
                                                 Height="12"
                                                 Fill="{StaticResource DangerBrush}"
                                                 Stroke="White"
                                                 StrokeThickness="1.2" />
                                        <TextBlock Canvas.Left="10"
                                                   Canvas.Top="-7"
                                                   Text="측정 시작점"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                    </Canvas>

                                    <Canvas Width="120"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ScaleY="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TranslateTransform X="{Binding DirectionPreviewX}"
                                                                    Y="{Binding DirectionPreviewY}" />
                                            </TransformGroup>
                                        </Canvas.RenderTransform>
                                        <Ellipse Canvas.Left="-6"
                                                 Canvas.Top="-6"
                                                 Width="12"
                                                 Height="12"
                                                 Fill="#00D4AA"
                                                 Stroke="White"
                                                 StrokeThickness="1.2" />
                                        <TextBlock Canvas.Left="10"
                                                   Canvas.Top="-7"
                                                   Text="측선 방향"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                    </Canvas>

                                    <ItemsControl ItemsSource="{Binding MapPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Left" Value="{Binding ScreenX}" />
                                                <Setter Property="Canvas.Top" Value="{Binding ScreenY}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform
                                                            ScaleX="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ScaleY="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid.RenderTransform>
                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Margin="-7,-7,0,0"
                                                             Fill="{StaticResource DangerBrush}"
                                                             Stroke="White"
                                                             StrokeThickness="1.5" />
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Margin="10,-7,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SavedResultPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Left" Value="{Binding ScreenX}" />
                                                <Setter Property="Canvas.Top" Value="{Binding ScreenY}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tooltip}">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform
                                                            ScaleX="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ScaleY="{Binding InverseMapScale, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid.RenderTransform>
                                                    <Line X1="0"
                                                          Y1="0"
                                                          X2="{Binding LabelOffsetX}"
                                                          Y2="{Binding LabelOffsetY}"
                                                          Stroke="#FFE0A8"
                                                          StrokeThickness="0.9"
                                                          Opacity="0.7" />
                                                    <Ellipse Width="12"
                                                             Height="12"
                                                             Margin="-6,-6,0,0"
                                                             Fill="#FFB300"
                                                             Stroke="White"
                                                             StrokeThickness="1" />
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="#FFE0A8"
                                                               FontSize="8.5">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform X="{Binding LabelOffsetX}"
                                                                                Y="{Binding LabelOffsetY}" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="12"
                                        Padding="10,8"
                                        Background="#CC111821"
                                        BorderBrush="{StaticResource BorderBrush1}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MaxWidth="330"
                                        IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding CoordinateReferenceText}" />
                                        <TextBlock x:Name="CursorCoordinateText"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="커서  X : -    Y : -" />
                                        <TextBlock x:Name="CursorGeographicText"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="커서  위도 : -    경도 : -" />
                                        <TextBlock x:Name="StartCoordinateText"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="시작점  X : -    Y : -" />
                                        <TextBlock x:Name="StartGeographicText"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="시작점  위도 : -    경도 : -" />
                                        <TextBlock x:Name="DirectionCoordinateText"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="방향점  X : -    Y : -" />
                                        <TextBlock x:Name="DirectionGeographicText"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="방향점  위도 : -    경도 : -" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#90020308"
                                        Visibility="{Binding IsMapLoading, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MapLoadingText}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10" />
                                        <ProgressBar Width="180"
                                                     Height="8"
                                                     IsIndeterminate="True" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="배경 지도" Style="{StaticResource PanelHeaderText}" />
                            </StackPanel>

                            <TextBlock Text="maps 폴더의 DWG 파일을 이름 순서대로 자동 표시합니다."
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />

                            <ScrollViewer Margin="0,12,0,0"
                                          Height="210"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MapEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Style="{StaticResource MapChip}"
                                                    Click="MapChipButton_Click"
                                                    Tag="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14"
                                        Background="#7C4DFF"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="선택 지도 경로" Style="{StaticResource PanelHeaderText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MapDwgPath}"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14"
                                        Background="#FFB300"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="불러온 저장 결과" Style="{StaticResource PanelHeaderText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding LoadedSavedResultText}"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

