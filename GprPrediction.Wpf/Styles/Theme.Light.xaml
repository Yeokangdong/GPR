<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#EEF2F7</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceAlt">#E9EEF5</Color>
    <Color x:Key="ColorTitleBarBackground">#F8FAFC</Color>
    <Color x:Key="ColorStatusBarBackground">#E7EDF5</Color>
    <Color x:Key="ColorBorder">#CBD5E1</Color>
    <Color x:Key="ColorAccent">#3478F6</Color>
    <Color x:Key="ColorAccentHover">#0A84FF</Color>
    <Color x:Key="ColorAccentPressed">#2463D4</Color>
    <Color x:Key="ColorDanger">#E5484D</Color>
    <Color x:Key="ColorTextPrimary">#182230</Color>
    <Color x:Key="ColorTextSecondary">#617086</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource ColorTitleBarBackground}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource ColorStatusBarBackground}" />
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#F8FBFF" />
    <SolidColorBrush x:Key="SecondaryControlBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="ReportCanvasBackgroundBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="ReportCanvasTextBrush" Color="#334155" />
    <SolidColorBrush x:Key="ReportConsoleBackgroundBrush" Color="#F7F9FC" />

    <SolidColorBrush x:Key="DashboardBackground" Color="#EEF2F7" />
    <SolidColorBrush x:Key="DashboardPanel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DashboardPanelRaised" Color="#F7F9FC" />
    <SolidColorBrush x:Key="DashboardBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="DashboardBorderHover" Color="#9FB2C8" />
    <SolidColorBrush x:Key="DashboardText" Color="#172033" />
    <SolidColorBrush x:Key="DashboardMuted" Color="#617086" />
    <SolidColorBrush x:Key="DashboardBlue" Color="#3478F6" />
    <SolidColorBrush x:Key="DashboardCyan" Color="#0F9F92" />
    <SolidColorBrush x:Key="DashboardViolet" Color="#6E56CF" />
    <SolidColorBrush x:Key="DashboardWarning" Color="#B77900" />
    <SolidColorBrush x:Key="DashboardTitleBar" Color="#F8FAFC" />
    <SolidColorBrush x:Key="DashboardInset" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DashboardInsetBorder" Color="#D5DEE9" />
    <SolidColorBrush x:Key="DashboardHover" Color="#E8EFF8" />
    <SolidColorBrush x:Key="DashboardSelected" Color="#E4EFFF" />
    <SolidColorBrush x:Key="DashboardGridLine" Color="#AAB8C8" />
    <SolidColorBrush x:Key="DashboardStatusBar" Color="#E7EDF5" />
    <SolidColorBrush x:Key="DashboardToolbarText" Color="#3E4C60" />
</ResourceDictionary>
